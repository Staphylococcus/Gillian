spec answer(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]] [[ (ret == 0i) ]] normal
proc answer(n) { ret := "helper"(n); return };
proc helper(n) {
head: invariant ((0i i<= n) * types(n : Int)) [bind: n] variant(n);
  goto [n i> 0i] step done;
step: n := n i- 1i;
  goto head;
done: ret := n;
  return
};
