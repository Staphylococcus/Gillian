nounfold pred Slot(a:Obj): <Cell>(a, "value"; 42i);
spec main()
[[ emp ]] [[ (ret == 0i) ]] normal
proc main() {
  unfold Slot($lclosed);
  n := 2i;
head: invariant ((0i i<= n) * types(n : Int)) [bind: n] variant(n);
  goto [n i> 0i] step done;
step: n := n i- 1i;
  goto head;
done: ret := n;
  return
};
