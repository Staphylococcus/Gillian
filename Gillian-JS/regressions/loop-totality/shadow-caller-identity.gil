proc helper(n) {
head: invariant ((n == #n) * (0i i<= #n) * types(#n : Int)) [bind: n, #n] variant(n);
  goto [n i> 0i] step done;
step: n := n i- 1i; goto head;
done: ret := n; return
};
spec count(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]] [[ (ret == #n) ]] normal
proc count(n) { unused := "helper"(n); ret := n; return };
