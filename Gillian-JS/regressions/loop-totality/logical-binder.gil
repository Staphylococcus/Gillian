spec count(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]]
[[ (ret == 0i) ]] normal
proc count(n) {
head: invariant ((n == #current) * (0i i<= #current) * types(#current : Int)) [bind: n, #current] variant(n);
  goto [n i> 0i] step done;
step: n := n i- 1i;
  goto head;
done: ret := n;
  return
};
