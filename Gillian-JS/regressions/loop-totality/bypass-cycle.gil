spec count(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]]
[[ (ret == 0i) ]] normal
proc count(n) {
head: invariant ((0i i<= n) * types(n : Int)) [bind: n] variant(n);
  goto [n i> 0i] step done;
step: goto [n i> 1i] spin progress;
spin: goto [n i> 1i] spin head;
progress: n := n i- 1i;
  goto head;
done: ret := n;
  return
};
