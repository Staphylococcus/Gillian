spec count(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]]
[[ (ret == 0i) ]] normal
proc count(n) {
head: invariant ((0i i<= n) * types(n : Int)) [bind: n] variant(n);
  goto [n i> 0i] step done;
step: n := n i- 1i;
  goto head;
done: n := 5i;
second: invariant ((0i i<= n) * types(n : Int)) [bind: n] variant(n);
  goto [n i> 0i] again final;
again: n := n i- 1i;
  goto second;
final: ret := n;
  return
};
