pure nounfold pred TypedChoice(n) :
  types(n : Int) * (n == 0i), types(n : Bool);
lemma CheckChoice(n)
[[ types(#n : Utf16) * TypedChoice(#n) ]]
[[ emp ]]
[* unfold TypedChoice(#n) *]

spec answer(n)
[[ (n == #n) * types(#n : Utf16) * TypedChoice(#n) ]]
[[ emp ]] normal
proc answer(n) {
  apply CheckChoice(n);
  ret := n;
  return
};
