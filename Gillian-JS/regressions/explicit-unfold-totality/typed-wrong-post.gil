pure nounfold pred TypedChoice(n) :
  types(n : Int) * (n == 0i), types(n : Bool);
lemma CheckChoice(n)
[[ types(#n : Int) * TypedChoice(#n) ]]
[[ (#n == 1i) ]]
[* unfold TypedChoice(#n) *]

spec answer(n)
[[ (n == #n) * types(#n : Int) * TypedChoice(#n) ]]
[[ (ret == 0i) ]] normal
proc answer(n) {
  apply CheckChoice(n);
  ret := n;
  return
};
