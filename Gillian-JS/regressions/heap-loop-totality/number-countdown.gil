spec count(obj)
[[ (obj == #obj) * <Cell>(#obj, "n"; #initial) * types(#initial : Num) * (is_int(#initial)) * (#initial <= 4294967295.0) * (0.0 <= #initial) ]]
[[ <Cell>(#obj, "n"; #final) * (#final == 0.0) * (ret v== #final) ]] normal
proc count(obj) {
head: invariant (<Cell>(obj, "n"; #value) * types(#value : Num) * (is_int(#value)) * (#value <= 4294967295.0) * (0.0 <= #value)) [bind: #value] variant(#value);
  cell := [GetCell](obj, "n");
  n := l-nth(cell, 2i);
  goto [n > 0.0] step done;
step: unused := [SetCell](obj, "n", n - 1.0); goto head;
done: ret := n; return
};
