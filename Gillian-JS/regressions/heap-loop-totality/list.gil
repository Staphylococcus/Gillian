spec count(obj)
[[ (obj == #obj) * <Cell>(#obj, "xs"; #initial) * types(#initial : List) ]]
[[ <Cell>(#obj, "xs"; {{ }}) * (ret == 0i) ]] normal
proc count(obj) {
head: invariant (<Cell>(obj, "xs"; #rest) * types(#rest : List)) [bind: #rest] variant(l-len(#rest));
  cell := [GetCell](obj, "xs");
  xs := l-nth(cell, 2i);
  goto [l-len(xs) i> 0i] step done;
step: unused := [SetCell](obj, "xs", cdr(xs)); goto head;
done: ret := l-len(xs); return
};
