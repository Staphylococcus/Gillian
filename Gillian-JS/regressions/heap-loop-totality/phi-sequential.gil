spec count(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]]
[[ (ret == 0i) ]] normal
proc count(n) {
  goto head;
head: PHI(current: n, next; copy: current, current);
  invariant ((0i i<= current) * types(current : Int) * (copy == current)) variant(current);
  goto [current i> 0i] step done;
step: next := current i- 1i;
  goto head;
done: ret := copy;
  return
};
