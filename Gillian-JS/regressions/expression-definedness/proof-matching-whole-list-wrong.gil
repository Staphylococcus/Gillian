pure nounfold pred VacantList(id; xs : List) : (xs == {{ }});
spec answer(xs) [[ (xs == #xs) * types(#xs : List) ]] [[ (ret == #xs) ]] normal
proc answer(xs) {
 fold VacantList(0i, {{ }});
 sep_assert (VacantList(0i; #prefix) * types(#suffix : List) * (#xs == l+(#prefix, #suffix))) [bind: #prefix, #suffix];
 assert (#suffix == {{ }});
 ret := xs; return
};
