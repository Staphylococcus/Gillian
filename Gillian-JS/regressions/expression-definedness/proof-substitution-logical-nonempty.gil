spec helper() <chosen: #unused>
[[ emp ]] [[ (ret == 42i) ]] normal
proc helper() { ret := 42i; return };
spec answer(xs)
[[ (xs == #xs) * types(#xs : List) * (0i i< l-len(#xs)) ]]
[[ (ret == 42i) ]] normal
proc answer(xs) {
  ret := "helper"() use_subst [chosen - #unused: l-nth(#xs, 0i)];
  return
};
