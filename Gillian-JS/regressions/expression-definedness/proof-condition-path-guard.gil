spec answer(xs)
[[ (xs == #xs) * types(#xs : List) ]]
[[ (ret == 42i) ]] normal
proc answer(xs) {
  if (0i i< l-len(xs)) then {
    assert (l-len(l-sub(xs, 1i, 0i)) == 0i);
    if (l-len(l-sub(#xs, 1i, 0i)) == 0i) then { assert (true) } else { assert (false) }
  } else { assert (l-len(xs) == 0i) };
  ret := 42i; return
};
