nounfold pred Cell(obj; value) : <Cell>(obj, "x"; value);
guard: emp;
spec answer(obj)
[[ (obj == #obj) * Cell(#obj; 42i) ]] [[ (ret == 42i) * Cell(#obj; 42i) ]] normal
proc answer(obj) {
  unfold Cell(obj, 42i);
  cell := [GetCell](obj, "x");
  ret := l-nth(cell, 2i);
  fold Cell(obj, 42i);
  return
};
