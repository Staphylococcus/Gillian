pure nounfold pred Counted(n : Int) : (n == 0i), (0i i< n) * Counted(n i- 1i);
lemma Count(n) variant(#n)
[[ types(#n : Int) * (0i i<= #n) ]]
[[ Counted(#n) ]]
[* if (#n i> 0i) then { apply Count(#n i- 1i) }; fold Counted(#n) *]

spec answer(n)
[[ (n == #n) * types(#n : Int) * (0i i<= #n) ]] [[ Counted(#n) * (ret == #n) ]] normal
proc answer(n) { apply Count(n); ret := n; return };
