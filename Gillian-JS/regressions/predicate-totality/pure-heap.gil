pure nounfold pred Cell(obj; value) : <Cell>(obj, "x"; value);
spec answer(obj)
[[ (obj v== #obj) * Cell(#obj; 42i) ]] [[ (ret == 7i) * Cell(#obj; 42i) ]] normal
proc answer(obj) {
  unfold Cell(obj, 42i);
  ignored := [SetCell](obj, "x", 7i);
  cell := [GetCell](obj, "x");
  ret := l-nth(cell, 2i);
  return
};
