spec walk(xs)
[[ (xs == #xs) * types(#xs : List) ]]
[[ (ret == 0i) ]] variant(l-len xs) normal
proc walk(xs) {
  goto [xs == {{ }}] done step;
step: fresh := [Alloc](empty, null);
  obj := l-nth(fresh, 0i);
  unused := [GetCell](obj, "tail");
  unused := [SetCell](obj, "tail", cdr xs);
  cell := [GetCell](obj, "tail");
  unused := [DeleteObject](obj);
  ret := "walk"(l-nth(cell, 2i));
  return;
done: ret := 0i;
  return
};
